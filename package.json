{
  "name": "worldwide-local",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-brand.mjs && vite build && node scripts/generate-offline-assets.mjs",
    "start": "node server/index.ts",
    "check": "tsc --noEmit",
    "test": "node tests/map-transitions.mjs && node tests/detailed-outlines.mjs && node tests/map-focus.mjs && node tests/map-styles.mjs && node tests/terrain.mjs && node tests/photo-layout.mjs && node tests/offline-worker.mjs && node tests/local-server.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs",
    "desktop:windows": "npm run desktop:build -- --win --x64",
    "desktop:mac": "npm run desktop:build -- --mac",
    "android:build": "node scripts/build-android.mjs",
    "android:sync": "node scripts/build-android.mjs --sync-only",
    "desktop:test": "electron desktop/smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "Your private world photo album",
  "author": "Worldwide",
  "main": "desktop/main.cjs"
}
