<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_back" android:layout_width="64dp" android:layout_height="match_parent" android:gravity="center" android:text="World" android:textColor="#FFFFFF" android:shadowColor="#000000" android:shadowRadius="3" android:contentDescription="Back to world map"/>
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textColor="#FFFFFF" android:shadowColor="#000000" android:shadowRadius="3" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="match_parent" android:gravity="center" android:text="Next ›" android:textColor="#FFFFFF" android:shadowColor="#000000" android:shadowRadius="3" android:contentDescription="Next country with photos"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/widget_map" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Your world map"/>
        <LinearLayout android:id="@+id/widget_grid" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"/>
    </FrameLayout>
    <ImageView android:id="@+id/widget_photo" android:layout_width="match_parent" android:layout_height="96dp" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="Country photo. Tap for next photo."/>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:textColor="#FFFFFF" android:shadowColor="#000000" android:shadowRadius="3" android:textSize="12sp"/>
</LinearLayout>
