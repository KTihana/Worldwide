<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowRadius">1</item>
        <item name="android:shadowDy">0</item>
    </style>
    <style name="WidgetSubtitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowRadius">1</item>
        <item name="android:shadowDy">0</item>
    </style>
    <style name="WidgetHint">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowRadius">1</item>
        <item name="android:shadowDy">0</item>
    </style>
    <style name="WidgetEmptyText" parent="WidgetHint">
        <item name="android:textColor">#EEFFFFFF</item>
    </style>
</resources>
